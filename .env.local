# Save as .env.local in your g2-asr project root (same folder as package.json).
# Vite only exposes vars prefixed with VITE_ to app code.
# Restart the dev server after changing this file - env is read at startup,
# not on hot reload.

# Your gateway through NPM. Must be wss:// - the app is served over https
# and a plain ws:// URL is blocked as mixed content.
VITE_GATEWAY_URL=wss://g2gateway.sams-server.duckdns.org:50443/ws/stt

# The AUTH_TOKEN from your compose .env. The template calls this variable
# API_KEY and passes it straight through as the gateway token.
VITE_STT_API_KEY=change-me-to-a-long-random-string
